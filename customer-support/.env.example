# Sign in at https://platform.zoowork.ai, select a Project, then API Keys -> create a key.
# Copy the zwp_live_ key into this server-side variable. Work/organization zct_ keys are not accepted.
# See README.md: Get your Project key. Never paste a key into browser code or chat.
ZOOWORK_API_KEY=
# Explicit public API URL; change this to the staging URL for an authorized staging smoke.
ZOOWORK_BASE_URL=https://clawapi.ecap.gsmo.ai/service/v1
# Optional model from listModels(). Empty uses platform defaults for setup.
ZOOWORK_MODEL=
# Local browser server. It binds to localhost.
PORT=4600
