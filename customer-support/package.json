{
  "name": "@zoowork-platform/customer-support",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm run check:ui && npm test",
    "setup": "node --env-file-if-exists=.env --import tsx scripts/platform.ts setup",
    "status": "node --env-file-if-exists=.env --import tsx scripts/platform.ts status",
    "cleanup": "node --env-file-if-exists=.env --import tsx scripts/platform.ts cleanup",
    "dev": "node --env-file-if-exists=.env --import tsx scripts/server.ts",
    "test:browser": "playwright test",
    "check:ui": "node --check public/app.js"
  },
  "dependencies": {
    "@zoowork-ai/sdk": "0.14.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "22.20.1",
    "tsx": "4.23.7",
    "typescript": "5.6.3"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
