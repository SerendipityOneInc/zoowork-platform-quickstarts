{
  "name": "@zoowork-platform/knowledge-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "setup": "node --env-file-if-exists=.env --import tsx scripts/platform.ts setup",
    "status": "node --env-file-if-exists=.env --import tsx scripts/platform.ts status",
    "cleanup": "node --env-file-if-exists=.env --import tsx scripts/platform.ts cleanup"
  },
  "dependencies": {
    "@zoowork-ai/sdk": "0.12.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.23.7",
    "typescript": "5.6.3"
  }
}
