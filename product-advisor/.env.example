# Create a Project key at https://platform.zoowork.ai. Server-side only.
ZOOWORK_API_KEY=
# Optional. Empty uses the published SDK's production default.
# Staging: https://claw-interface.ecap.yesy.live/service/v1
# ZOOWORK_BASE_URL=
# Optional model from listModels(). Empty uses platform defaults for setup.
# ZOOWORK_MODEL=
# Optional hosted catalog. npm run demo starts a local MCP + HTTPS tunnel when omitted.
# MCP_PUBLIC_URL=
# The application API validates this exact same-origin URL.
# APP_ORIGIN=http://localhost:4310
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Optional override; otherwise private .local/cookie-secret is generated and reused.
# APP_COOKIE_SECRET=
# Local readonly MCP server. The demo chooses an available local port.
# MCP_HOST=localhost
# MCP_PORT=4311
# Optional comma-separated incoming Origin/Host allowlists (server calls omit Origin).
# MCP_ALLOWED_ORIGINS=
# MCP_ALLOWED_HOSTS=
# Only feature-staging needs the private audit DB of this same MCP instance.
# MCP_AUDIT_DB=
