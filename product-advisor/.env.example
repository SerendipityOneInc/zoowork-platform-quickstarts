# Create a Project key at https://platform.zoowork.ai. Server-side only.
ZOOWORK_API_KEY=
# Explicit public API URL; change this to the staging URL for an authorized staging smoke.
ZOOWORK_BASE_URL=https://clawapi.ecap.gsmo.ai/service/v1
# Optional model from listModels(). Empty uses platform defaults for setup.
ZOOWORK_MODEL=
# Public unauthenticated HTTPS endpoint; Engine cannot call localhost/private IPs.
MCP_PUBLIC_URL=
# The application API validates this exact same-origin URL.
APP_ORIGIN=http://localhost:4310
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_COOKIE_SECRET=
# Local readonly MCP server; public hosting/tunnels require separate authorization.
MCP_HOST=localhost
MCP_PORT=4311
# Optional comma-separated incoming Origin/Host allowlists (server calls omit Origin).
MCP_ALLOWED_ORIGINS=
MCP_ALLOWED_HOSTS=
# Only feature-staging needs the private audit DB of this same MCP instance.
MCP_AUDIT_DB=
