{
  "name": "@zoowork-platform/research-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "setup": "node --env-file-if-exists=.env --import tsx scripts/platform.ts setup",
    "status": "node --env-file-if-exists=.env --import tsx scripts/platform.ts status",
    "cleanup": "node --env-file-if-exists=.env --import tsx scripts/platform.ts cleanup",
    "test:staging": "node --env-file-if-exists=.env --import tsx scripts/staging.ts",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/main.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "build": "node --import tsx scripts/build.ts",
    "update-agent": "node --env-file-if-exists=.env --import tsx scripts/platform.ts update",
    "recover": "node --env-file-if-exists=.env --import tsx scripts/platform.ts recover",
    "test:browser": "playwright test",
    "test:research-staging": "node --env-file-if-exists=.env --import tsx scripts/research-staging.ts --confirm-staging",
    "dev:fixture": "node --import tsx test/fixture-server.ts"
  },
  "dependencies": {
    "@zoowork-ai/sdk": "0.9.0",
    "chat": "4.34.0",
    "@chat-adapter/web": "4.34.0",
    "@chat-adapter/state-memory": "4.34.0",
    "@ai-sdk/react": "4.0.129",
    "ai": "7.0.126",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "hono": "4.13.12",
    "@hono/node-server": "2.1.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.23.7",
    "typescript": "5.6.3",
    "esbuild": "0.25.12",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@playwright/test": "1.63.0"
  }
}
