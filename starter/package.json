{
  "name": "@zoowork-platform/starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "next dev --hostname localhost",
    "preview": "node --import tsx scripts/preview.ts",
    "build": "next build",
    "start": "next start --hostname localhost",
    "setup": "node --env-file-if-exists=.env --import tsx scripts/agent.ts setup",
    "status": "node --env-file-if-exists=.env --import tsx scripts/agent.ts status",
    "cleanup": "node --env-file-if-exists=.env --import tsx scripts/agent.ts cleanup",
    "models": "node --env-file-if-exists=.env --import tsx scripts/agent.ts models",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@assistant-ui/react": "0.14.27",
    "@assistant-ui/react-markdown": "0.14.6",
    "@zoowork-ai/sdk": "0.12.0",
    "assistant-stream": "0.3.26",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.26.0",
    "next": "16.2.11",
    "radix-ui": "1.6.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "tw-shimmer": "0.4.12",
    "yaml": "2.9.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
